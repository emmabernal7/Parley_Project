# Copy this file to ".env" and fill in whichever of these you have. Every line is optional -
# the app runs with none of them set (it uses the offline chat + its own fair odds only).

# --- Chat LLM Provider (deepseek | gemini | anthropic | auto | offline)
SQ_LLM=deepseek

# --- DeepSeek (Recomendado para análisis matemático cuantitativo y +EV)
# Obtén tu clave en https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Para usar DeepSeek local (Ollama / vLLM desde el repo GitHub):
# DEEPSEEK_BASE_URL=http://localhost:11434/v1

# --- Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Odds comparison (optional). Get a free key (500 credits/mo) at https://the-odds-api.com
THE_ODDS_API_KEY=

# --- Misc overrides (all optional; see config/settings.yaml for the full list with comments)
# SQ_PORT=8000
# SQ_PROVIDERS=espn
